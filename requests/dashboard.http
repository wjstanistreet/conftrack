### Everything the dashboard page draws, in one call
GET {{baseUrl}}/api/dashboard/summary
Accept: application/json

> {%
    client.test("summary loads", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### The settings the application is running with, checked against application.yml
# Ticket 02. Needs no database, so it works as soon as the application starts.
GET {{baseUrl}}/api/dashboard/settings
Accept: application/json

> {%
    client.test("minimumRating is the value application.yml sets", function () {
        client.assert(response.body.minimumRating === 2,
            "application.yml sets the minimum rating to 2, but the application is running with "
            + response.body.minimumRating + ". Is that key in application.yml actually being read?");
    });
    client.test("recentDays comes from the reporting profile", function () {
        client.assert(response.body.recentDays === 7,
            "application-reporting.yml sets recentDays to 7, but the application is running with "
            + response.body.recentDays + ". Is the reporting profile actually being loaded?");
    });
%}

### Scores count unhappy ratings
# Ticket 05. A session with feedback should never score 0, however unhappy that feedback was.
GET {{baseUrl}}/api/dashboard/summary
Accept: application/json

> {%
    client.test("every session with feedback has a score above 0", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        const zero = response.body.filter(function (row) {
            return row.feedbackCount > 0 && row.score <= 0;
        });
        client.assert(zero.length === 0,
            zero.length + " sessions with feedback score 0, for example session " + (zero.length ? zero[0].sessionId : "")
            + " (average rating " + (zero.length ? zero[0].averageRating : "") + "). Their unhappy ratings are being thrown away.");
    });
%}

### Unhappy ratings count extra
# Ticket 05, continued.
GET {{baseUrl}}/api/dashboard/settings
Accept: application/json

> {%
    client.test("unhappy ratings carry the weight application.yml sets", function () {
        client.assert(response.body.lowRatingWeight === 1.5,
            "application.yml sets the low rating weight to 1.5, but the application is running with "
            + response.body.lowRatingWeight + ". Something is overriding it.");
    });
%}

### Which beans the running application actually has
GET {{baseUrl}}/actuator/beans
Accept: application/json

### Which configuration values actually won
GET {{baseUrl}}/actuator/configprops
Accept: application/json
